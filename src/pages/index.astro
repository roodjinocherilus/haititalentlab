---
// Page d'accueil — vitrine institutionnelle. 11 sections, doc 02 §3.
// Copy reprise du doc 02 à l'identique.
import { Image } from 'astro:assets';
import heroPilote from '@/assets/pilote/cap-talent-lab-hero.jpg';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PreuveSociale from '@/components/PreuveSociale.astro';
import ProblemeBlock from '@/components/ProblemeBlock.astro';
import DoubleCta from '@/components/DoubleCta.astro';
import BandeauPartenaires from '@/components/BandeauPartenaires.astro';
import Newsletter from '@/components/Newsletter.astro';
import Card from '@/components/Card.astro';
import { ArrowRight, Download } from '@lucide/astro';
import {
  ecosystem,
  nationalCalendar,
  organizationSchema,
  program,
} from '@/config/site';

const methode = [
  {
    t: 'Présélection',
    d: 'Candidats filtrés par formulaire structuré.',
  },
  {
    t: 'Préparation',
    d: "Ateliers et simulations d'entretien pour le jour J.",
  },
  {
    t: 'Dialogue',
    d: "Panel d'experts et recruteurs en public.",
  },
  {
    t: 'Rencontres',
    d: 'Entretiens directs et structurés pendant 2 jours.',
  },
];

const partenairesGains = [
  'Visibilité nationale sur 6 villes / 12 mois',
  'Accès privilégié à un vivier de talents qualifiés',
  'Positionnement RSE et marque employeur renforcés',
  'Contenu de marque (vidéos, prises de parole)',
  'Présence sur tous les supports nationaux et locaux',
];
---

<BaseLayout schema={organizationSchema}>
  {/* ─── 3.1 HERO ─── */}
  <section
    class="on-dark relative flex min-h-[100svh] flex-col justify-end overflow-hidden bg-navy"
    style="padding: 110px 6vw 9vh;"
  >
    <div
      class="pointer-events-none absolute inset-0 z-0"
      style="background: linear-gradient(to bottom, rgba(0,20,60,0.78) 0%, rgba(0,30,70,0.72) 40%, rgba(0,15,45,0.97) 100%);"
    >
    </div>
    <span
      class="pointer-events-none absolute left-[-1vw] top-1/2 z-0 -translate-y-1/2 select-none font-display font-extrabold leading-none text-white/[0.025]"
      style="font-family: var(--font-display); font-size: clamp(110px, 20vw, 280px); letter-spacing:-0.02em;"
      aria-hidden="true">HAITI</span
    >
    <div
      class="absolute inset-x-0 bottom-0 z-[2] h-[5px]"
      style="background: linear-gradient(90deg, var(--color-orange) 0%, var(--color-sky) 100%);"
    >
    </div>

    <div class="relative z-[1] grid w-full max-w-[1200px] gap-12 lg:grid-cols-[1.5fr_1fr] lg:items-end">
      <div>
        <div
          class="fu mb-7 flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.2em] text-orange"
        >
          <span class="flex gap-[5px]" aria-hidden="true">
            <span class="block h-[7px] w-[7px] rounded-[1px] bg-orange"></span>
            <span class="block h-[7px] w-[7px] rounded-[1px] bg-orange"></span>
            <span class="block h-[7px] w-[7px] rounded-[1px] bg-orange"></span>
          </span>
          Programme national d'employabilité
        </div>

        <h1
          class="fu fu-d1 font-bold text-white"
          style="font-family: var(--font-display); font-size: clamp(44px, 6.4vw, 100px); line-height:1; letter-spacing:-0.015em; margin-bottom:32px;"
        >
          Le premier programme national<br />
          <span class="text-sky">d'employabilité d'Haïti</span>.
        </h1>

        <p class="fu fu-d2 max-w-[640px] text-[18px] leading-[1.6] text-white/70 sm:text-[20px]">
          <strong class="text-white">{program.citiesCount} villes. {program.duration}.</strong>
          Un pont entre les talents haïtiens et les opportunités réelles.
        </p>

        <div class="fu fu-d3 mt-9 flex flex-wrap gap-3">
          <a href="/partenaires" class="btn btn-primary">
            Devenir partenaire <ArrowRight class="h-4 w-4" />
          </a>
          <a href="/pilote" class="btn btn-outline on-dark">
            Découvrir le pilote
          </a>
        </div>
      </div>

      <div
        class="fu fu-d2 relative hidden aspect-[4/5] overflow-hidden rounded-[14px] border border-white/10 shadow-[0_24px_60px_rgba(0,0,0,0.4)] lg:block"
      >
        <Image
          src={heroPilote}
          alt="Candidat placé et membre de l'équipe ZLC à Cap Talent Lab — janvier 2026"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1024px) 40vw, 0px"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
        <div
          class="pointer-events-none absolute inset-0"
          style="background: linear-gradient(180deg, transparent 55%, rgba(0,15,45,0.55) 100%);"
        >
        </div>
        <span
          class="absolute bottom-4 left-4 right-4 text-[11px] font-semibold uppercase tracking-[0.14em] text-white/80"
        >
          Cap Talent Lab — Cap-Haïtien, janvier 2026
        </span>
      </div>
    </div>
  </section>

  {/* ─── 3.2 BLOC #1 — PREUVE SOCIALE ─── */}
  <PreuveSociale />

  {/* ─── 3.3 BLOC #2 — LE PROBLÈME ─── */}
  <ProblemeBlock />

  {/* ─── 3.4 LA RÉPONSE — MÉTHODE 4 ÉTAPES ─── */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[1100px]">
      <div class="eyebrow fu">Notre approche</div>
      <h2 class="h-section fu max-w-[760px]">
        Notre réponse : un programme, pas un événement.
      </h2>
      <p class="mt-5 max-w-[760px] text-[16px] leading-[1.7] text-ink fu">
        Haiti Talent Lab n'est pas un salon de l'emploi de plus. C'est un
        dispositif structuré, validé sur le terrain, et conçu pour produire
        des recrutements réels.
      </p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          methode.map((m, i) => (
            <Card accent="sky" class={`fu ${i ? `fu-d${i}` : ''}`}>
              <span
                class="font-display text-[34px] font-extrabold text-navy/15"
                style="font-family: var(--font-display);"
              >
                0{i + 1}
              </span>
              <h3
                class="mt-3 font-display text-[18px] font-bold uppercase tracking-[0.04em] text-navy"
                style="font-family: var(--font-display);"
              >
                {m.t}
              </h3>
              <p class="mt-2 text-[14px] leading-[1.6] text-ink">{m.d}</p>
            </Card>
          ))
        }
      </div>
      <div class="mt-9 fu">
        <a href="/programme" class="btn btn-outline">
          En savoir plus sur la méthode <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  {/* ─── 3.5 CALENDRIER NATIONAL — 6 VILLES ─── */}
  <section class="section on-dark bg-navy">
    <div class="mx-auto max-w-[1200px]">
      <div class="eyebrow fu">{program.citiesCount} villes. {program.duration}. Un programme national.</div>
      <h2 class="h-section fu max-w-[820px]">
        Le Haiti Talent Lab se déploie ville après ville.
      </h2>
      <p class="mt-5 max-w-[680px] text-[16px] leading-[1.7] text-white/55 fu">
        Chaque édition est adaptée aux réalités économiques locales, tout en
        s'inscrivant dans une dynamique nationale unifiée.
      </p>

      <div class="mt-10 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {
          nationalCalendar.map((c, i) => {
            const isLinked = !!c.url;
            const Wrapper = isLinked ? 'a' : 'div';
            return (
              <Wrapper
                href={c.url}
                {...(isLinked ? { target: '_blank', rel: 'noopener' } : {})}
                class:list={[
                  'group relative block rounded-[10px] border p-5 transition-all fu',
                  isLinked
                    ? 'border-white/10 bg-white/[0.02] hover:border-sky hover:bg-sky/[0.06]'
                    : 'border-white/[0.06] bg-white/[0.015]',
                  i && `fu-d${(i % 3) + 1}`,
                ]}
              >
                <div class="flex items-start justify-between gap-2">
                  <span
                    class="font-display text-[20px] font-bold text-white"
                    style="font-family: var(--font-display);"
                  >
                    📍 {c.city}
                  </span>
                  {!isLinked && (
                    <span class="rounded-[3px] bg-white/[0.06] px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.12em] text-white/35">
                      Bientôt
                    </span>
                  )}
                </div>
                <span class="mt-1 block text-[13px] text-sky-light">
                  {c.dateLabel}
                </span>
                <span class="mt-2 block text-[11px] uppercase tracking-[0.1em] text-white/30">
                  {c.note}
                </span>
                {isLinked && (
                  <span class="mt-4 inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-sky">
                    En savoir plus <ArrowRight class="h-3 w-3" />
                  </span>
                )}
              </Wrapper>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* ─── 3.6 APPEL PARTENAIRES — CŒUR BUSINESS ─── */}
  <section
    class="on-dark relative overflow-hidden bg-navy-mid"
    style="padding: 96px 6vw;"
  >
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(circle at 90% 10%, rgba(48,161,252,0.10) 0%, transparent 55%), radial-gradient(circle at 10% 100%, rgba(255,93,33,0.10) 0%, transparent 55%);"
    >
    </div>
    <div class="relative mx-auto max-w-[1100px]">
      <div class="eyebrow fu">Rejoignez les partenaires</div>
      <h2 class="h-section fu max-w-[820px]">
        Rejoignez les partenaires du programme national.
      </h2>
      <p class="mt-5 max-w-[760px] text-[17px] leading-[1.7] text-white/65 fu">
        Haiti Talent Lab mobilise un budget annuel de
        <strong class="text-white">{program.budgetLabel}</strong> pour son
        déploiement national. Nous recherchons des partenaires stratégiques
        pour transformer durablement l'employabilité en Haïti.
      </p>

      <div
        class="mt-9 rounded-[14px] border border-white/10 bg-white/[0.03] p-7 fu sm:p-9"
      >
        <h3
          class="font-display text-[14px] font-bold uppercase tracking-[0.14em] text-orange"
          style="font-family: var(--font-display);"
        >
          Ce que les partenaires y gagnent
        </h3>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            partenairesGains.map((g) => (
              <li class="flex items-start gap-3 text-[15px] leading-[1.5] text-white/85">
                <span
                  class="mt-2 block h-1.5 w-1.5 shrink-0 rounded-full bg-sky"
                  aria-hidden="true"
                />
                <span>{g}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-9 flex flex-wrap gap-3 fu">
        <a href="/partenaires" class="btn btn-primary">
          Devenir partenaire <ArrowRight class="h-4 w-4" />
        </a>
        <a href="/partenaires" class="btn btn-outline on-dark">
          <Download class="h-4 w-4" /> Télécharger le dossier (PDF)
        </a>
      </div>
    </div>
  </section>

  {/* ─── 3.7 BLOC #4 — DOUBLE CTA AUDIENCE ─── */}
  <DoubleCta
    eyebrow="Participez"
    title="Choisissez votre porte d'entrée."
    cards={[
      {
        title: 'Pour les talents',
        lead: 'Inscrivez-vous, faites vérifier vos compétences, accédez aux opportunités.',
        bullets: [
          'Inscription gratuite sur le Hub',
          'Profil vérifié par notre équipe',
          'Accès aux éditions locales et au vivier national',
        ],
        ctaLabel: "S'inscrire sur le Hub",
        ctaHref: ecosystem.hub,
        external: true,
      },
      {
        title: 'Pour les entreprises',
        lead: 'Recrutez parmi des talents présélectionnés et accédez à un vivier qualifié.',
        bullets: [
          'Présélection assurée par ZLC',
          'Entretiens directs sur place',
          'Suivi post-événement structuré',
        ],
        ctaLabel: 'Devenir partenaire recruteur',
        ctaHref: '/entreprises',
      },
    ]}
  />

  {/* ─── 3.8 PRESSE & CRÉDIBILITÉ ─── */}
  <section class="section bg-section">
    <div class="mx-auto max-w-[1100px]">
      <div class="eyebrow fu">Dans la presse</div>
      <h2 class="h-section fu">Ils en ont parlé</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          [0, 1, 2].map((i) => (
            <Card class={`fu ${i ? `fu-d${i}` : ''}`}>
              <div
                class="h-9 w-24 rounded-[4px] border border-dashed border-navy/15 bg-white"
                aria-hidden="true"
              />
              <p class="mt-5 text-[14px] italic leading-[1.7] text-ink">
                « [Citation du média sur le pilote — à rassembler avec ZLC] »
              </p>
              <a
                href="/presse"
                class="mt-5 inline-flex items-center gap-1.5 text-[13px] font-semibold text-sky hover:underline"
              >
                Lire <ArrowRight class="h-3.5 w-3.5" />
              </a>
            </Card>
          ))
        }
      </div>
      <p class="mt-4 text-[12px] italic text-muted fu">
        Citations presse réelles du pilote janvier 2026 — à rassembler avec ZLC.
      </p>
      <div class="mt-7 flex flex-wrap gap-3 fu">
        <a href="/presse" class="btn btn-outline">
          Voir tous les articles <ArrowRight class="h-4 w-4" />
        </a>
        <a href="/presse" class="btn btn-outline">
          Espace presse <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  {/* ─── 3.9 BLOC #5 — BANDEAU PARTENAIRES ─── */}
  <BandeauPartenaires
    title="Ils nous font confiance"
    ctaLabel="Devenir partenaire"
    ctaHref="/partenaires"
    count={12}
  />

  {/* ─── 3.10 BLOC #6 — NEWSLETTER ─── */}
  <Newsletter
    title="Restez informé"
    text="Recevez les annonces des prochaines éditions, les ouvertures de candidatures, et les nouvelles du programme."
  />
</BaseLayout>

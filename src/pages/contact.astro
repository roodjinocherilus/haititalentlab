---
// Page Contact — 4 contacts qualifiés + formulaire général. Doc 02 §12.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Card from '@/components/Card.astro';
import { ArrowRight, MapPin } from '@lucide/astro';
import {
  contacts,
  formsConfigured,
  formspreeEndpoint,
  social,
} from '@/config/site';
---

<BaseLayout
  title="Contact"
  description="Contactez l'équipe Haiti Talent Lab : partenariats, presse, entreprises recruteuses, candidats."
>
  <PageHero
    eyebrow="Contact"
    title={'<span class="text-sky">Contactez-nous</span>'}
    subtitle="Choisissez le bon interlocuteur, ou écrivez-nous directement."
    ghost="CONTACT"
  />

  {/* 4 CONTACTS QUALIFIÉS */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[1200px]">
      <div class="eyebrow fu">Contacts qualifiés</div>
      <h2 class="h-section fu">Le bon interlocuteur.</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          contacts.map((c, i) => (
            <Card accent="sky" class={`fu ${i ? `fu-d${i % 3 + 1}` : ''}`}>
              <h3
                class="font-display text-[16px] font-bold uppercase tracking-[0.06em] text-navy"
                style="font-family: var(--font-display);"
              >
                {c.audience}
              </h3>
              <p class="mt-4 text-[14px] text-ink">{c.name}</p>
              <a
                href={`mailto:${c.email}`}
                class="mt-1 block text-[13px] font-medium text-sky hover:underline"
              >
                {c.email}
              </a>
              <p class="mt-1 text-[13px] text-muted">{c.phone}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* FORMULAIRE GÉNÉRAL */}
  <section class="section bg-section">
    <div class="mx-auto max-w-[720px]">
      <div class="eyebrow fu">Formulaire général</div>
      <h2 class="h-section fu">Écrivez-nous.</h2>

      <form
        class="js-contact mt-9 flex flex-col gap-4 fu"
        action={formspreeEndpoint || undefined}
        method="POST"
      >
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="sr-only" for="c-nom">Nom</label>
            <input id="c-nom" name="nom" required placeholder="Nom" class="field" />
          </div>
          <div>
            <label class="sr-only" for="c-email">E-mail</label>
            <input
              id="c-email"
              type="email"
              name="email"
              required
              placeholder="E-mail"
              class="field"
            />
          </div>
        </div>
        <div>
          <label class="sr-only" for="c-org">Organisation</label>
          <input
            id="c-org"
            name="organisation"
            placeholder="Organisation"
            class="field"
          />
        </div>
        <div>
          <label class="sr-only" for="c-type">Type de demande</label>
          <select id="c-type" name="type" class="field" required>
            <option value="" disabled selected>Type de demande</option>
            <option>Partenariat</option>
            <option>Presse</option>
            <option>Entreprise</option>
            <option>Candidat</option>
            <option>Autre</option>
          </select>
        </div>
        <div>
          <label class="sr-only" for="c-msg">Message</label>
          <textarea
            id="c-msg"
            name="message"
            required
            rows="5"
            placeholder="Votre message"
            class="field resize-y"></textarea>
        </div>
        <button type="submit" class="btn btn-primary self-start">
          Envoyer <ArrowRight class="h-4 w-4" />
        </button>
      </form>
      {
        !formsConfigured && (
          <p class="mt-3 text-[12px] italic text-muted">
            Envoi bientôt actif (configuration e-mail en attente). En
            attendant, écrivez directement aux adresses ci-dessus.
          </p>
        )
      }
      <p class="js-contact-ok mt-3 hidden text-[14px] font-medium text-sky">
        Merci ! Votre message a bien été envoyé.
      </p>
    </div>
  </section>

  {/* ADRESSE + RÉSEAUX SOCIAUX */}
  <section class="section bg-white">
    <div class="mx-auto grid max-w-[1100px] gap-8 md:grid-cols-2">
      <Card class="fu">
        <div class="flex items-start gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-orange/10">
            <MapPin class="h-5 w-5 text-orange" />
          </span>
          <div>
            <h3 class="font-display text-[16px] font-bold text-navy" style="font-family: var(--font-display);">
              Zero Loss Consulting
            </h3>
            <p class="mt-2 text-[14px] leading-[1.7] text-ink">
              [Adresse complète Port-au-Prince — à compléter]
            </p>
          </div>
        </div>
      </Card>
      <Card class="fu fu-d1">
        <h3 class="font-display text-[16px] font-bold text-navy" style="font-family: var(--font-display);">
          Réseaux sociaux
        </h3>
        <ul class="mt-4 flex flex-wrap gap-4">
          {
            social.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="text-[12px] font-semibold uppercase tracking-[0.1em] text-navy/65 transition-colors hover:text-orange"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </Card>
    </div>
  </section>
</BaseLayout>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('.js-contact')) {
    form.addEventListener('submit', async (e) => {
      if (!form.action) {
        e.preventDefault();
        return;
      }
      e.preventDefault();
      const ok = document.querySelector('.js-contact-ok');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.reset();
          ok?.classList.remove('hidden');
        }
      } catch {
        /* silencieux */
      }
    });
  }
</script>

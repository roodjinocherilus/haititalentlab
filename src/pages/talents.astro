---
// Page Talents — candidats. Doc 02 §8.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import TimelineEvent from '@/components/TimelineEvent.astro';
import Card from '@/components/Card.astro';
import Newsletter from '@/components/Newsletter.astro';
import { ArrowRight, Check } from '@lucide/astro';
import { ecosystem } from '@/config/site';

const gains = [
  'Préparation gratuite (ateliers, simulations)',
  'Accès direct aux recruteurs (sans intermédiaire)',
  'Profil vérifié = crédibilité renforcée',
  'Suivi post-événement',
];
const parcours = [
  { title: 'Inscription sur le Haiti Talent Hub' },
  { title: 'Vérification de votre profil' },
  { title: "Candidature à l'édition de votre ville" },
  { title: 'Préparation aux entretiens (ateliers)' },
  { title: 'Rencontres directes le jour J' },
  { title: 'Suivi du placement' },
];
const hubAtouts = [
  'Talents vérifiés',
  "Ancré en Haïti",
  'Entreprises de confiance',
];
---

<BaseLayout
  title="Talents"
  description="Votre talent mérite d'être vu. Inscrivez-vous sur le Hub, faites vérifier vos compétences, rencontrez les entreprises qui recrutent."
>
  <PageHero
    eyebrow="Talents"
    title={'Votre talent <span class="text-sky">mérite d\'être vu</span>.'}
    subtitle="Inscrivez-vous, faites vérifier vos compétences, rencontrez les entreprises qui recrutent."
    ghost="TALENTS"
    ctas={[
      {
        label: "S'inscrire sur le Hub",
        href: ecosystem.hub,
        external: true,
      },
      {
        label: 'Postuler à Cayes Talent Lab',
        href: ecosystem.cayesTalentLab,
        variant: 'outline',
        external: true,
      },
    ]}
  />

  {/* POURQUOI PARTICIPER */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[1100px]">
      <div class="eyebrow fu">Pourquoi participer</div>
      <h2 class="h-section fu">Quatre bonnes raisons.</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          gains.map((g, i) => (
            <Card accent="sky" class={`fu ${i ? `fu-d${i}` : ''}`}>
              <span
                class="font-display text-[34px] font-extrabold text-navy/15"
                style="font-family: var(--font-display);"
              >
                0{i + 1}
              </span>
              <p class="mt-3 text-[15px] font-medium leading-[1.55] text-navy">
                {g}
              </p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* LE PARCOURS TALENT */}
  <section class="section bg-section">
    <div class="mx-auto max-w-[760px]">
      <div class="eyebrow fu">Le parcours talent</div>
      <h2 class="h-section fu">De l'inscription au placement.</h2>
      <div class="mt-10">
        <TimelineEvent steps={parcours} tone="light" />
      </div>
    </div>
  </section>

  {/* LE HAITI TALENT HUB */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[1000px]">
      <div class="eyebrow fu">Le Haiti Talent Hub</div>
      <h2 class="h-section fu">La plateforme qui vous garde visible toute l'année.</h2>
      <p class="mt-5 text-[16px] leading-[1.7] text-ink fu">
        Le Hub est la plateforme partenaire du programme. Vous y construisez
        votre profil, vous restez visible des recruteurs entre les éditions,
        et vous accédez aux opportunités locales et nationales.
      </p>
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        {
          hubAtouts.map((a, i) => (
            <Card class={`fu ${i ? `fu-d${i}` : ''}`}>
              <Check class="h-5 w-5 text-sky" />
              <p class="mt-3 text-[15px] font-medium text-navy">{a}</p>
            </Card>
          ))
        }
      </div>
      <div class="mt-8 fu">
        <a
          href={ecosystem.hub}
          target="_blank"
          rel="noopener"
          class="btn btn-primary"
        >
          Aller sur haititalenthub.com <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  {/* TÉMOIGNAGES */}
  <section class="section bg-section">
    <div class="mx-auto max-w-[1100px]">
      <div class="eyebrow fu">Témoignages — candidats placés</div>
      <h2 class="h-section fu">Ils sont passés par là.</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          [0, 1, 2].map((i) => (
            <Card class={`fu ${i ? `fu-d${i}` : ''}`}>
              <div class="flex items-center gap-4">
                <div
                  class="h-14 w-14 shrink-0 rounded-full border border-dashed border-navy/20 bg-white"
                  aria-hidden="true"
                />
                <div>
                  <span class="block text-[14px] font-semibold text-navy">
                    [Nom]
                  </span>
                  <span class="block text-[12px] text-muted">
                    [Fonction obtenue]
                  </span>
                </div>
              </div>
              <p class="mt-5 text-[14px] italic leading-[1.7] text-ink">
                « [Citation courte à recueillir auprès de ZLC] »
              </p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* PROCHAINES ÉCHÉANCES */}
  <section class="section on-dark bg-navy">
    <div class="mx-auto max-w-[820px] text-center">
      <div class="eyebrow justify-center fu">Prochaines échéances</div>
      <h2 class="h-section fu">Cayes Talent Lab — Juillet 2026</h2>
      <p class="mt-5 text-[17px] leading-[1.7] text-white/65 fu">
        Candidatures ouvertes pour la 1ʳᵉ édition nationale aux Cayes.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 fu">
        <a
          href={ecosystem.cayesTalentLab}
          target="_blank"
          rel="noopener"
          class="btn btn-primary"
        >
          Postuler à Cayes Talent Lab <ArrowRight class="h-4 w-4" />
        </a>
        <a
          href={ecosystem.hub}
          target="_blank"
          rel="noopener"
          class="btn btn-outline on-dark"
        >
          S'inscrire sur le Hub
        </a>
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>

---
// Page À propos — ZLC, Woodmy JB, équipe, histoire, valeurs. Doc 02 §11.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import TimelineEvent from '@/components/TimelineEvent.astro';
import Card from '@/components/Card.astro';
import Newsletter from '@/components/Newsletter.astro';
import { ArrowRight } from '@lucide/astro';
import { ecosystem, org } from '@/config/site';

const histoire = [
  { tag: '< 2025', title: "Naissance de l'idée", text: "Constat partagé : un manque de pont structuré entre talents haïtiens et entreprises." },
  { tag: '2025', title: 'Conception du modèle', text: 'ZLC structure une méthode reproductible, validée par des entreprises pilotes.' },
  { tag: 'Janv. 2026', title: 'Pilote Cap Talent Lab', text: 'Cap-Haïtien — 2 jours, 200 candidatures, 20+ entreprises, 4,9 / 5.' },
  { tag: '2026', title: 'Lancement national', text: 'Haiti Talent Lab — 6 villes, 12 mois.' },
  { tag: '2027 →', title: 'Vision', text: '[Vision à long terme à formuler avec ZLC]' },
];

const valeurs = [
  'Le talent existe en Haïti, c\'est le pont qui manque.',
  'Pas de symbolique, des résultats mesurables.',
  "L'ancrage local est notre force.",
  'La rigueur opérationnelle est notre méthode.',
];
---

<BaseLayout
  title="À propos"
  description="Qui porte Haiti Talent Lab ? Une initiative de Zero Loss Consulting, conçue, opérée et financée en Haïti."
>
  <PageHero
    eyebrow="À propos"
    title={'Qui porte <span class="text-sky">Haiti Talent Lab</span> ?'}
    subtitle="Une initiative de Zero Loss Consulting, conçue, opérée et financée en Haïti."
    ghost="ZLC"
  />

  {/* ZERO LOSS CONSULTING */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[820px]">
      <div class="eyebrow fu">Zero Loss Consulting</div>
      <h2 class="h-section fu">Une firme haïtienne au cœur du dispositif.</h2>
      <div class="mt-7 flex flex-col gap-5 text-[16px] leading-[1.75] text-ink">
        <p class="fu">
          [Paragraphe 1 — Qui est ZLC : firme haïtienne, périmètre, gestion
          opérationnelle. À compléter avec ZLC.]
        </p>
        <p class="fu">
          [Paragraphe 2 — Pourquoi ZLC porte ce programme : continuité avec
          leur métier, expertise terrain.]
        </p>
        <p class="fu">
          [Paragraphe 3 — Leur conviction : l'employabilité ne se décrète
          pas, elle se construit par un dispositif rigoureux.]
        </p>
      </div>
      <div class="mt-7 fu">
        <a
          href={org.url}
          target="_blank"
          rel="noopener"
          class="btn btn-outline"
        >
          {org.url.replace('https://', '')} <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  {/* WOODMY JEAN BAPTISTE */}
  <section class="section bg-section">
    <div class="mx-auto grid max-w-[1000px] gap-12 lg:grid-cols-[1fr_1.5fr] lg:items-center">
      <div
        class="aspect-square rounded-[14px] border border-dashed border-navy/15 bg-white fu"
        aria-hidden="true"
      >
        <div class="grid h-full place-items-center">
          <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-navy/25">
            Portrait — à fournir
          </span>
        </div>
      </div>
      <div>
        <div class="eyebrow fu">Direction</div>
        <h2 class="h-section fu">Woodmy Jean Baptiste</h2>
        <p class="mt-4 text-[16px] leading-[1.75] text-ink fu">
          [Bio courte 3-4 lignes — parcours, vision pour l'employabilité en
          Haïti, rôle dans le programme. À compléter avec ZLC.]
        </p>
        <a
          href="#"
          class="mt-6 inline-flex items-center gap-2 text-[14px] font-semibold text-sky hover:underline fu"
        >
          Suivre sur LinkedIn <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  {/* ÉQUIPE OPÉRATIONNELLE */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[1200px]">
      <div class="eyebrow fu">Équipe opérationnelle</div>
      <h2 class="h-section fu">Les femmes et les hommes du programme.</h2>
      <div class="mt-9 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5 fu">
        {
          Array.from({ length: 10 }).map(() => (
            <Card padding="p-5">
              <div
                class="mx-auto h-20 w-20 rounded-full border border-dashed border-navy/20 bg-section"
                aria-hidden="true"
              />
              <p class="mt-3 text-center text-[13px] font-semibold text-navy">
                [Nom]
              </p>
              <p class="text-center text-[11px] text-muted">[Fonction]</p>
            </Card>
          ))
        }
      </div>
      <p class="mt-4 text-[12px] italic text-muted fu">
        6 à 10 portraits — trombinoscope avec hover qui révèle la bio
        (à compléter).
      </p>
    </div>
  </section>

  {/* HISTOIRE */}
  <section class="section bg-section">
    <div class="mx-auto max-w-[820px]">
      <div class="eyebrow fu">Histoire</div>
      <h2 class="h-section fu">De l'idée au déploiement national.</h2>
      <div class="mt-10">
        <TimelineEvent steps={histoire} tone="light" numbered={false} />
      </div>
    </div>
  </section>

  {/* VALEURS */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[820px]">
      <div class="eyebrow fu">Valeurs & convictions</div>
      <h2 class="h-section fu">Ce qui nous tient.</h2>
      <ul class="mt-8 flex flex-col gap-5 fu">
        {
          valeurs.map((v, i) => (
            <li class="flex items-start gap-4">
              <span
                class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-orange/10 font-display text-[14px] font-extrabold text-orange"
                style="font-family: var(--font-display);"
                aria-hidden="true"
              >
                0{i + 1}
              </span>
              <p class="text-[17px] font-medium leading-[1.6] text-navy">
                {v}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* CTA FINAL */}
  <section class="section on-dark bg-navy">
    <div class="mx-auto max-w-[760px] text-center">
      <h2 class="h-section fu">Travaillons ensemble.</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-3 fu">
        <a href="/contact" class="btn btn-primary">
          Nous contacter <ArrowRight class="h-4 w-4" />
        </a>
        <a href="/partenaires" class="btn btn-outline on-dark">
          Devenir partenaire
        </a>
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
